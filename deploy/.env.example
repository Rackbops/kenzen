# kenzen node-app deploy -- copy to `.env` (next to compose.yaml in the stack dir) and fill the
# <PLACEHOLDERS>. Compose reads it for ${...} substitution; publish/deploy-pull.sh reads
# REGISTRY_* to log in before pulling. RUNTIME SECRETS ONLY -- never committed, never an image
# layer (docker history must show none, K4-6's own acceptance).
#
# This is committed as an EXAMPLE: every operator SECRET below is a <PLACEHOLDER>, never a real
# token (the concrete defaults like ghcr.io / latest are non-secret). NEVER commit a filled-in
# .env -- it stays gitignored wherever it's actually deployed.

# --- The image to run (deploy-pull.sh resolves the same ref via `docker compose config --images`) ---
IMAGE=ghcr.io/rackbops/kenzen
# A moving tag (latest) auto-swaps on each new digest; a pinned vX.Y.Z is reproducible, manual-bump.
IMAGE_TAG=latest

# --- Private-registry pull auth (deploy-pull.sh: `docker login $REGISTRY -u $REGISTRY_USER`) ---
# ghcr.io/rackbops/kenzen is a PRIVATE package -- the box needs a read:packages credential.
REGISTRY=ghcr.io
REGISTRY_USER=<REGISTRY_USERNAME>
REGISTRY_TOKEN=<REGISTRY_READ_PACKAGES_TOKEN>

# --- The per-app Cloudflare token tunnel (the cloudflared sidecar reads this) ---
# From the Access-app + tunnel setup in the gate runbook (Cloudflare API), for kenzen's own tunnel.
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>

# --- kenzen's own ingest auth (design.md section 4.2; the server itself reads this) ---
# Generated once (never in either repo), stored here for this deploy and on the ingesting side
# per Tooling's own notify.secrets_path("kenzen.json"). The server refuses to start without it --
# there is no config.toml fallback for a secret (main.ts's requireIngestToken, K4-4).
KENZEN_INGEST_TOKEN=<KENZEN_INGEST_TOKEN>

# --- The app's own config (optional; the image ships sane defaults) ---
# kenzen binds all interfaces so the sidecar can reach it in-network:
KENZEN_HOST=0.0.0.0
